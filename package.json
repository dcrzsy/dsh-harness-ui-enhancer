{
  "name": "dsh-enhance-tool",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "description": "DeepSeek Harness (dsh) web UI enhancer — polish, prompt library, suggested replies, width/font settings, MCP & automation panels.",
  "homepage": "https://github.com/dcrzsy/dsh-enhance-tool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcrzsy/dsh-enhance-tool.git"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}